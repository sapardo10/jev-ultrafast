# Decision model. ollama uses Ollama System One (nimble); local-llm runs a local instruct model; laya and typesafe are selectable.
# typesafe is selected automatically when TYPESAFE_API_KEY is set.
DECISION_BACKEND=local-llm
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Ollama backend (DECISION_BACKEND=ollama): Ollama 0.35+ System One API, fully local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nimble

# Local instruct model for decisions and TYPE_TEXT (in-process transformers).
LOCAL_LLM_MODEL=Qwen/Qwen3-1.7B
# Or point at an OpenAI-compatible server instead, e.g. mlx_lm.server --port 8080:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_API_KEY=
# With Ollama: LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1, LOCAL_LLM_MODEL=nimble, LOCAL_LLM_REASONING=none, LOCAL_LLM_JSON=1

# Laya backend (DECISION_BACKEND=laya). typed-decisions is the fine-tuned checkpoint;
# root is the English base; multilingual covers 100+ languages.
LAYA_MODEL=convaiinnovations/laya
LAYA_SUBFOLDER=typed-decisions
LAYA_DEVICE=
LAYA_MAX_LEN=2048
LAYA_HEAD_MAX_LEN=512
LAYA_CHUNK_SIZE=24

# Remote text helper. Without TEXT_MODEL_API_KEY the local instruct model writes values.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
